# KEEPER Configuration Example
# Copy this file to .env and fill in your values

PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/keeper?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Brevo / SMTP Email Credentials for OTP Delivery
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_password
SMTP_FROM="Keeper Security" <no-reply@yourdomain.com>

# Optional Supabase Legacy Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
